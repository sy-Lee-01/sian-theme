---
import Base from '../../layouts/Base.astro';
import WritingList from '../../components/WritingList.astro';
import { sections, kinds } from '../../site.config';

export function getStaticPaths() {
  return kinds.map((kind) => ({
    params: { section: sections[kind].path },
    props: { kind },
  }));
}

const { kind } = Astro.props;
---
<Base lang="ko" title={sections[kind].title}>
  <h1>{sections[kind].title}</h1>
  <WritingList kind={kind} />
</Base>
