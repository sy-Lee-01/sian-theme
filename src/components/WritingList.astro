---
import type { Kind } from '../site.config';
import { getWriting, writingUrl, formatDate } from '../lib/writing';

interface Props { kind: Kind }
const entries = await getWriting(Astro.props.kind);
---
{entries.length === 0 ? (
  <p class="empty">아직 글이 없습니다.</p>
) : (
  <ul class="writing-list">
    {entries.map((e) => (
      <li>
        <a href={writingUrl(e.data.kind, e.id)}>{e.data.title}</a>
        <time datetime={e.data.date.toISOString()}>{formatDate(e.data.date, 'ko')}</time>
      </li>
    ))}
  </ul>
)}
